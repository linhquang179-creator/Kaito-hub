spawn(function()
    while task.wait(0.03) do
        pcall(function()
            local plr = game.Players.LocalPlayer
            if not plr or not plr.Character then return end
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChild("Humanoid")
            if not root or not hum then return end

            -- Chống AFK
            if getgenv().AntiAfk then
                game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
            end

            -- Tăng tốc + Bay
            hum.WalkSpeed = getgenv().Speed and 300 or 16
            hum.PlatformStand = getgenv().Fly or false
            if getgenv().Fly then root.Velocity = Vector3.new(0,50,0) end

            -- Hồi máu tự động
            if getgenv().AutoHeal and hum.Health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end

            -- Gom quái
            if getgenv().BringMobs and getgenv().MobRange then
                for _, mob in pairs(workspace:GetDescendants()) do
                    if mob.Name == "HumanoidRootPart" and mob.Parent:FindFirstChild("Humanoid") 
                    and mob.Parent.Humanoid.Health > 0 
                    and (mob.Position - root.Position).Magnitude < getgenv().MobRange then
                        mob.CFrame = CFrame.new(root.Position.X, root.Position.Y + 3, root.Position.Z)
                    end
                end
            end

            -- ⚡ Click NHANH NHẤT / Gần 0 giây
            if getgenv().AutoClick and getgenv().ClickDelay then
                task.wait(getgenv().ClickDelay)
                local remotes = game:GetService("ReplicatedStorage"):FindFirstChild("Remotes")
                if remotes and remotes:FindFirstChild("Click") then
                    remotes.Click:FireServer(nil, getgenv().AutoMastery and "Mastery" or nil)
                end
            end
        end)
    end
end)

